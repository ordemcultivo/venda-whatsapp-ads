    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Extrai o número do remoteJid (ex: 5511999999999@s.whatsapp.net)\nconst remoteJid = $json.data.key.remoteJid;\nconst phone = remoteJid.replace('@s.whatsapp.net', '').replace(/\\D/g, '');\n\n// Garante código do Brasil (+55)\nconst phoneFormatted = phone.startsWith('55') ? phone : '55' + phone;\n\n// Hash SHA256 obrigatório pelo Meta\nconst hashedPhone = crypto.createHash('sha256').update(phoneFormatted).digest('hex');\n\nconst timestamp = Math.floor(Date.now() / 1000);\n\n// Monta o payload completo da CAPI\nconst capiPayload = {\n  data: [{\n    event_name: 'Lead',\n    event_time: timestamp,\n    action_source: 'other',\n    user_data: {\n      ph: [hashedPhone]\n    }\n  }],\n  access_token: 'SEU_TOKEN_AQUI'\n};\n\nreturn [{ json: { capiPayload, phone: phoneFormatted, timestamp } }];"
      },
      "id": "node-code-003",
      "name": "Prepara dados CAPI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 220]
