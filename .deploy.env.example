# Configurações de deploy — copie para .deploy.env e preencha
# NUNCA commite o arquivo .deploy.env (está no .gitignore)

SSH_HOST=seu.servidor.com.br   # IP ou domínio do servidor
SSH_USER=root                   # usuário SSH
SSH_KEY=~/.ssh/id_venda         # caminho da chave privada local
REMOTE_DIR=/root/venda-whatsapp-ads
GIT_BRANCH=main
